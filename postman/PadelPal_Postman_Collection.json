        {
          "name": "Get Bookings by User (userId=1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "http://localhost:8083/api/bookings/user/1"
          }
        },
        {
          "name": "Create Booking - Invalid User (userId=999, courtId=1)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "http://localhost:8083/api/bookings?userId=999&courtId=1"
          }
        },
        {
          "name": "Create Booking - Invalid Court (userId=1, courtId=999)",
          "request": {
